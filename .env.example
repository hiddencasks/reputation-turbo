# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Postgres connection string (Supabase: Project Settings > Database > Connection string > Transaction pooler)
DATABASE_URL=postgres://rt:rt@localhost:5432/rt

# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dashboard login. Create the hash with: npm run hash-password -- "your long password"
ADMIN_EMAIL=info@reputationturbo.com
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters (e.g. from: openssl rand -hex 32)
SESSION_SECRET=

# Email (Resend). Leave RESEND_API_KEY empty locally to only record emails instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Reputation Turbo <info@reputationturbo.com>
# Where new-lead notifications go
OWNER_EMAIL=info@reputationturbo.com
