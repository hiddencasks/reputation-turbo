# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Postgres connection string (Supabase: Project Settings > Database > Connection string > Transaction pooler)
DATABASE_URL=postgres://rt:rt@localhost:5432/rt

# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dashboard login. Create the hash with: npm run hash-password -- "your long password"
ADMIN_EMAIL=info@reputationturbo.com
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters (e.g. from: openssl rand -hex 32)
SESSION_SECRET=

# Email (Resend). Leave RESEND_API_KEY empty locally to only record emails instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Reputation Turbo <info@reputationturbo.com>
# Where new-lead notifications go
OWNER_EMAIL=info@reputationturbo.com

# AI visibility checks. Each service below is used only when its key is set; add at least one.
# Costs are billed by each provider per check (each check asks 4 questions per service).
# ChatGPT (OpenAI): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini with Google Search: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Perplexity: https://www.perplexity.ai/account/api
PERPLEXITY_API_KEY=
# Claude (Anthropic): https://platform.claude.com. Also used to read each answer and list the businesses it names.
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: gpt-5, gemini-3.8-flash, claude-opus-5-5.
# Perplexity picks its model from an effort preset (fast, low, medium, high); default fast.
OPENAI_MODEL=
GEMINI_MODEL=
PERPLEXITY_EFFORT=
CLAUDE_MODEL=
# Protects the daily scheduled job (/api/cron/ai-checks). Any random string; Vercel sends it automatically.
CRON_SECRET=
# Most checks the website forms may start in 24 hours (default 40). Checks you start in the dashboard don't count.
AI_CHECK_DAILY_LIMIT=
# Free online audit: Google Business Profile lookup and the top 3 Google Maps competitors (Places API: two lookups, about $0.07 per audit;
# Google gives 1,000 of these lookups free each month, so roughly the first 500 audits a month cost nothing).
# Leave empty to review Google profiles by hand. https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=
# Local development and tests only: 1 uses built-in sample answers instead of real AI services.
AI_CHECK_FAKE=
